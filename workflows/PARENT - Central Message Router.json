    {
      "parameters": {
        "jsCode": "// Recuperiamo l'array di input in modo sicuro secondo lo standard n8n v1+\nconst items = $input.all();\n\nlet processedItems = items.map(item => {\n    // Estrazione sicura del body, con fallback in caso di payload vuoto\n    const body = item.json.body || {};\n    \n    const rawText = body.text || \"\";\n    const customerId = body.customer_id || \"GUEST-\" + Math.floor(Math.random() * 10000);\n    const email = body.email || \"unknown@enterprise.com\";\n    \n    // Sanitizzazione Enterprise: Escaping degli apostrofi per prevenire SQL Injection e crash sintattici su PostgreSQL\n    // Sostituisce il singolo apice ' con due singoli apici '' (standard SQL ANSI)\n    const sanitizedText = rawText.replace(/'/g, \"''\").trim();\n\n    return {\n        json: {\n            metadata: {\n                customer_id: customerId,\n                customer_email: email,\n                ingested_at: new Date().toISOString(),\n                raw_text_length: rawText.length\n            },\n            payload: {\n                text_clean: sanitizedText,\n                text_original: rawText\n            }\n        }\n    };\n});\n\nreturn processedItems;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
